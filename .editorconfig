root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PowerShell: UTF-8 med BOM, annars läser Windows PowerShell 5.1 svenska tecken fel
[*.{ps1,psm1,psd1}]
charset = utf-8-bom

# Bash-hooken: UTF-8 utan BOM, 2 mellanslag
[hooks/*]
charset = utf-8
indent_size = 2

[*.md]
charset = utf-8
trim_trailing_whitespace = false

[*.json]
indent_size = 2
